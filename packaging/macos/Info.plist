<?xml version="1.0" encoding="UTF-8"?>
<!-- Info.plist of Screen Snap.app. scripts/bundle-mac.sh fills in @VERSION@ from
     Cargo.toml when it builds the bundle. LSUIElement keeps the menu-bar app out of
     the Dock and the app switcher; NSScreenCaptureUsageDescription is the text macOS
     may show when asking for the Screen Recording permission. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Screen Snap</string>
	<key>CFBundleName</key>
	<string>Screen Snap</string>
	<key>CFBundleExecutable</key>
	<string>screensnap</string>
	<key>CFBundleIconFile</key>
	<string>screensnap</string>
	<key>CFBundleIdentifier</key>
	<string>com.larsbrubaker.screensnap</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Screen Snap freezes the screen so you can select the part to capture.</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License. Copyright (c) Lars Brubaker.</string>
</dict>
</plist>
